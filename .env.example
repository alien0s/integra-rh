# ===== FASTIFY (API) =====
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ===== CORS =====
FRONTEND_URL=http://localhost:5173

# ===== AUTENTICAÇÃO (liga/desliga) =====
# false = auth desativada (modo dev, abre direto nas features).
# true  = auth ativada (login obrigatório: e-mail + senha via LDAP/AD).
# Mantenha os dois valores iguais.
AUTH_ENABLED=true
VITE_AUTH_ENABLED=true

# ===== LDAP / ACTIVE DIRECTORY (login principal: e-mail + senha) =====
# É o método PRINCIPAL de login: a senha do usuário é validada no AD da empresa.
# Peça ao TI os valores abaixo. Enquanto LDAP_ENABLED=false, em desenvolvimento
# o login é SIMULADO (qualquer senha entra) — em produção, exige o AD.
#
# O que o TI precisa fornecer/criar:
#  1) Endereço do controlador de domínio (AD) e porta:
#       LDAP  ->  389   (ou 636 para LDAPS/TLS: use ldaps://host:636)
#  2) Uma CONTA DE SERVIÇO (usuário de leitura, senha que não expira) usada só
#     para BUSCAR usuários no diretório — NÃO precisa ser admin. Informe o DN
#     completo dela (LDAP_BIND_DN) e a senha (LDAP_BIND_CREDENTIALS).
#  3) A BASE DE BUSCA (onde ficam os usuários), ex.: a OU de colaboradores.
#  4) O atributo usado no e-mail corporativo (normalmente 'mail';
#     alguns ambientes usam 'userPrincipalName').
LDAP_ENABLED=false
# ldap://HOST:389  ou  ldaps://HOST:636 (recomendado com TLS)
LDAP_URL=ldap://ad.adventistas.org:389
# DN da conta de serviço (formato AD costuma ser CN=...,OU=...,DC=...):
LDAP_BIND_DN=CN=svc-integrarh,OU=ServiceAccounts,DC=adventistas,DC=org
LDAP_BIND_CREDENTIALS=senha-da-conta-de-servico
# Base onde procurar os usuários (OU/estrutura do AD):
LDAP_SEARCH_BASE=OU=Usuarios,DC=adventistas,DC=org
# Filtro para achar o usuário pelo e-mail digitado ({{email}} é substituído).
# AD por e-mail:            (mail={{email}})
# AD por login/UPN:         (userPrincipalName={{email}})
# Restringir só a pessoas:  (&(objectClass=user)(mail={{email}}))
LDAP_SEARCH_FILTER=(mail={{email}})

# ===== JWT =====
JWT_SECRET=sua-chave-super-secreta-aleatoria-change-me
JWT_EXPIRES_IN=8h

# ===== POSTGRESQL =====
# A API conecta por campos separados (sem connection string), então a senha
# pode conter caracteres especiais (@, #, :) — recomenda-se usar aspas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp
DB_USER=erpuser
DB_PASSWORD="sua-senha-aqui"

# ===== SQL SERVER LEGADO (consulta de funcionários, somente leitura) =====
# Banco legado da empresa com os dados dos funcionários. Usado no 1º acesso
# (login por e-mail + senha) para preencher nome/entidade/departamento/função/
# cpf/telefone. Deixe MSSQL_ENABLED=false até ter as credenciais + a query.
MSSQL_ENABLED=false
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# ===== MICROSOFT OAUTH2 / SSO =====
# Obter no Azure Portal > App registrations > seu app
# https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=sua-chave-secreta-do-azure
# Use o Tenant ID da organização ou "common" para multi-tenant
MICROSOFT_TENANT_ID=seu-tenant-id-aqui
# URI de callback — deve ser registrada no Azure AD em "Redirect URIs"
# Dev:  http://localhost:3000/auth/microsoft/callback
# Prod: https://api.seu-dominio.com/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# ===== OBJECT STORAGE (MinIO / S3) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sua-access-key
S3_SECRET_KEY=sua-secret-key
S3_BUCKET=erp-arquivos
S3_PUBLIC_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ===== FRONTEND (Vite — apenas variáveis VITE_ são expostas ao browser) =====
# URL da API usada pelo frontend em produção (em dev usa o proxy do Vite)
VITE_API_URL=http://localhost:3000
# URL base do frontend
VITE_APP_URL=http://localhost:5173
