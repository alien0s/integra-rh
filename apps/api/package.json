{
  "name": "@erp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc --noEmit && tsup src/server.ts --format esm --sourcemap --clean --out-dir dist",
    "start": "node --env-file=../../.env dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:ldap": "tsx --env-file=../../.env src/scripts/test-ldap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/s3-request-presigner": "^3.1076.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/swagger": "9.8.1",
    "@scalar/fastify-api-reference": "1.64.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "ldapjs": "^3.0.7",
    "mssql": "^12.7.0",
    "postgres": "^3.4.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/ldapjs": "^3.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.0"
  }
}
