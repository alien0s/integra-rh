{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx pnpm@10.28.2 install --no-frozen-lockfile",
  "buildCommand": "npx pnpm@10.28.2 --filter @erp/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
